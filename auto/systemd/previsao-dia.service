[Unit]
Description=eventosextremospub — Previsão do Dia (último vídeo do canal de previsão), diário 10:00 (Short no lives10 + bot v3)
After=network-online.target stack99.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISPLAY=:99
ExecStart=/bin/bash -c 'exec /bin/bash %h/projetos/eventosextremospub/auto/rodar.sh "$(date +%%F)" previsao'
TimeoutStartSec=12h
MemoryMax=60G
Nice=5
